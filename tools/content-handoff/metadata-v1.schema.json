        "synthetic_example",
        "unknown_template",
        "owner_metadata"
      ]
    },
    "container": {
      "$ref": "#/$defs/container"
    },
    "observations": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "ncas": {
      "type": "array",
      "maxItems": 512,
