  "$id": "urn:pine:content-metadata-handoff:v1",
  "title": "Minimal nonsensitive content metadata INPUT v1",
  "description": "Metadata assertions only; no file bytes, authentication, runtime selection, paths, logs or keys. Omitted facts are unknown.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "data_kind",
    "container",
    "observations",
    "ncas",
    "cnmts"
