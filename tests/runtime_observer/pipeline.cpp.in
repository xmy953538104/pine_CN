struct Memory {
 struct Code{std::span<u8> host,guest;}code;
 memory::AddressSpaceType addressSpaceType{memory::AddressSpaceType::AddressSpace39Bit};
 size_t allocation{65536};u8*data{};
 Memory(){data=static_cast<u8*>(mmap(nullptr,allocation,PROT_READ|PROT_WRITE|PROT_EXEC,MAP_PRIVATE|MAP_ANONYMOUS,-1,0));assert(data!=MAP_FAILED);code={std::span(data,allocation),std::span(data,allocation)};}
 ~Memory(){munmap(data,allocation);}
 void MapHeapMemory(auto){}void SetRegionPermission(auto,memory::Permission){}void Reserve(auto){}
 void MapCodeMemory(auto,memory::Permission){}void MapMutableCodeMemory(auto){}
};
struct KProcess {
 diagnostics::runtime::ProcessObservation diagnosticObservation;
 Memory memory;struct {struct {struct {bool is64Bit{true};}flags;}meta;}npdm;
 explicit KProcess(const diagnostics::runtime::Profile&p,bool enabled):diagnosticObservation(p,diagnostics::runtime::Domain::ControlledSynthetic,enabled){}
};
