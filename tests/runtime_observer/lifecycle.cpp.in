namespace kernel::type {
#ifndef __ANDROID__
// Bionic's flat TID field has a nested glibc ABI equivalent. Convert only the
// dependency argument; execute the real OS timer_create, preserving its result.
struct sigevent {int sigev_signo{},sigev_notify{},sigev_notify_thread_id{};};
inline int timer_create(clockid_t clock,const sigevent*event,timer_t*timer){
    ::sigevent native{};native.sigev_signo=event->sigev_signo;native.sigev_notify=event->sigev_notify;
    native._sigev_un._tid=event->sigev_notify_thread_id;return ::timer_create(clock,&native,timer);
}
#endif
struct KProcess {
    r::ProcessObservation diagnosticObservation;
    std::mutex threadMutex;bool disableThreadCreation{};
    std::vector<std::shared_ptr<KThread>>threads;
    std::atomic<unsigned>killCalls{};
    std::array<u8,64>tls{};
    explicit KProcess(const r::Profile&p):diagnosticObservation(p,r::Domain::ControlledSynthetic,true){}
    ~KProcess();
    u8*AllocateTlsSlot(){return tls.data();}
    void Kill(bool){++killCalls;} // process scheduler/JVM side effects excluded
};
class KThread:public std::enable_shared_from_this<KThread> {
public:
    DeviceState state;KProcess&process;
    std::thread thread;pthread_t pthread{};timer_t preemptionTimer{};
    std::mutex statusMutex;std::condition_variable statusCondition;
    bool running{},ready{},killed{};size_t id{};
    std::mutex coreMigrationMutex;uint8_t coreId{};
    std::shared_ptr<r::GuestSlot>diagnosticSlotStorage;
    diagnostics::PendingGuestSignal pendingGuestSignal;
    std::jmp_buf originalCtx{};
    u8*tlsRegion{};void*entry{},*stackTop{};uint64_t entryArgument{},handle{};
    std::atomic<bool>tailEntered{},releaseTail{true};
    KThread(DeviceState s,KProcess&p,size_t tid):state(s),process(p),id(tid){}
    virtual ~KThread();
    virtual void Init()=0;virtual void Run()=0;
    void ThreadEntrypoint();void DiagnosticHostReturned();
    void Start(bool=false);void Kill(bool);
    void JoinBeforeDiagnosticContextDestruction();
    void Signal(){tailEntered.store(true,std::memory_order_release);while(!releaseTail.load(std::memory_order_acquire))std::this_thread::yield();}
};
class KNceThread:public KThread {
public:
    nce::ThreadContext ctx{};
    using KThread::KThread;
    ~KNceThread();void Init()override;void Run()override;
};
