struct Scheduler {
    static inline thread_local bool YieldPending{};
    static constexpr int PreemptionSignal=SIGUSR1;
    struct Core{uint8_t id{};};
    Core GetOptimalCoreForThread(const std::shared_ptr<type::KThread>&){return {};}
    void InsertThread(const std::shared_ptr<type::KThread>&){}
    void RemoveThread(){} void WaitSchedule(){} void Rotate(){}
};
}
struct Loader {std::string GetStackTrace(signal::StackFrame* =nullptr){return {};}};
struct DeviceState {
    static inline thread_local std::shared_ptr<kernel::type::KThread>thread;
    kernel::Scheduler*scheduler{};kernel::type::KProcess*process{};Loader*loader{};
};
struct TrapManager {static inline bool handled{};static bool TrapHandler(u8*,bool){return handled;}};
